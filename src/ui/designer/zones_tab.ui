              <item row="2" column="1">
               <widget class="QLineEdit" name="spawnIdEdit">
                <property name="toolTip">
                 <string>The spawn's template Id. Spawns that come every raid and share an Id are alternatives: the server spawns one of them each raid</string>
                </property>
               </widget>
              </item>
              <item row="3" column="0">
               <widget class="QLabel" name="spawnPositionLabel">
                <property name="text">
                 <string>Position (x, y, z)</string>
                </property>
               </widget>
              </item>
              <item row="3" column="1">
               <layout class="QHBoxLayout" name="spawnPositionRow">
                <item>
                 <widget class="QDoubleSpinBox" name="spawnXSpin">
                  <property name="toolTip">
                   <string>East (metres)</string>
                  </property>
                  <property name="decimals">
                   <number>3</number>
                  </property>
                  <property name="minimum">
                   <double>-5000</double>
                  </property>
                  <property name="maximum">
                   <double>5000</double>
                  </property>
                  <property name="singleStep">
                   <double>0.05</double>
                  </property>
                 </widget>
                </item>
                <item>
                 <widget class="QDoubleSpinBox" name="spawnYSpin">
                  <property name="toolTip">
                   <string>Up (metres)</string>
                  </property>
                  <property name="decimals">
                   <number>3</number>
                  </property>
                  <property name="minimum">
                   <double>-5000</double>
                  </property>
                  <property name="maximum">
                   <double>5000</double>
                  </property>
                  <property name="singleStep">
                   <double>0.05</double>
                  </property>
                 </widget>
                </item>
                <item>
                 <widget class="QDoubleSpinBox" name="spawnZSpin">
                  <property name="toolTip">
                   <string>North (metres)</string>
                  </property>
                  <property name="decimals">
                   <number>3</number>
                  </property>
                  <property name="minimum">
                   <double>-5000</double>
                  </property>
                  <property name="maximum">
                   <double>5000</double>
                  </property>
                  <property name="singleStep">
                   <double>0.05</double>
                  </property>
                 </widget>
                </item>
               </layout>
              </item>
              <item row="4" column="0">
               <widget class="QLabel" name="spawnYawLabel">
                <property name="text">
                 <string>Turned</string>
                </property>
               </widget>
              </item>
              <item row="4" column="1">
               <widget class="QDoubleSpinBox" name="spawnYawSpin">
                <property name="toolTip">
                 <string>Degrees clockwise, seen from above (its y rotation)</string>
                </property>
                <property name="decimals">
                 <number>1</number>
                </property>
                <property name="minimum">
                 <double>0</double>
                </property>
                <property name="maximum">
                 <double>360</double>
                </property>
                <property name="singleStep">
                 <double>5</double>
                </property>
                <property name="suffix">
                 <string>°</string>
                </property>
                <property name="wrapping">
                 <bool>true</bool>
                </property>
               </widget>
              </item>
              <item row="5" column="0">
               <widget class="QLabel" name="spawnChanceLabel">
                <property name="text">
                 <string>Spawns</string>
                </property>
               </widget>
              </item>
              <item row="5" column="1">
               <layout class="QHBoxLayout" name="spawnChanceRow">
                <item>
                 <widget class="QCheckBox" name="spawnAlwaysBox">
                  <property name="toolTip">
                   <string>IsAlwaysSpawn: it spawns every raid. A forced file's spawns always do</string>
                  </property>
                  <property name="text">
                   <string>Every raid</string>
                  </property>
                 </widget>
                </item>
                <item>
                 <widget class="QDoubleSpinBox" name="spawnChanceSpin">
                  <property name="toolTip">
                   <string>Its probability. Loose loot: its weight against the map's own loose loot points (1: every raid). Spawns every raid that share an Id: how likely this one is the one that spawns</string>
                  </property>
                  <property name="decimals">
                   <number>3</number>
                  </property>
                  <property name="minimum">
                   <double>0</double>
                  </property>
                  <property name="maximum">
                   <double>1</double>
                  </property>
                  <property name="singleStep">
                   <double>0.05</double>
                  </property>
                  <property name="prefix">
                   <string>chance </string>
                  </property>
                 </widget>
                </item>
               </layout>
              </item>
              <item row="6" column="0" colspan="2">
               <layout class="QHBoxLayout" name="spawnOptionsRow">
                <item>
                 <widget class="QCheckBox" name="spawnGravityBox">
                  <property name="toolTip">
                   <string>useGravity: it falls onto what is under it when the raid starts. Off: it stays where it is put</string>
                  </property>
                  <property name="text">
                   <string>Falls into place</string>
                  </property>
                 </widget>
                </item>
                <item>
                 <widget class="QCheckBox" name="spawnRandomBox">
                  <property name="toolTip">
                   <string>randomRotation: it is turned at random</string>
                  </property>
                  <property name="text">
                   <string>Random turn</string>
                  </property>
                 </widget>
                </item>
               </layout>
              </item>
              <item row="7" column="0" colspan="2">
               <layout class="QHBoxLayout" name="spawnButtonsRow">
                <item>
                 <widget class="QPushButton" name="spawnFloorButton">
                  <property name="toolTip">
                   <string>Put it on the floor, or the top of what is under it (a table, a shelf)</string>
                  </property>
                  <property name="text">
                   <string>Put on floor</string>
                  </property>
                 </widget>
                </item>
                <item>
                 <widget class="QPushButton" name="spawnLookButton">
                  <property name="toolTip">
                   <string>Bring it into view (F)</string>
                  </property>
                  <property name="text">
                   <string>Look at it</string>
                  </property>
                 </widget>
                </item>
               </layout>
              </item>
              <item row="8" column="0" colspan="2">
               <layout class="QHBoxLayout" name="spawnButtonsRow2">
                <item>
                 <widget class="QPushButton" name="copySpawnButton">
                  <property name="toolTip">
                   <string>Add a copy of this spawn to your spawn file, to change</string>
                  </property>
                  <property name="text">
                   <string>Copy as a new spawn</string>
                  </property>
                 </widget>
                </item>
                <item>
                 <widget class="QPushButton" name="deleteSpawnButton">
                  <property name="toolTip">
                   <string>Take this spawn out of your spawn file (Delete)</string>
                  </property>
                  <property name="text">
                   <string>Delete</string>
                  </property>
                 </widget>
                </item>
               </layout>
              </item>
             </layout>
            </widget>
           </item>
           <item>
            <spacer name="spawnsPageSpacer">
             <property name="orientation">
              <enum>Qt::Vertical</enum>
             </property>
             <property name="sizeHint" stdset="0">
              <size>
               <width>10</width>
               <height>0</height>
              </size>
             </property>
            </spacer>
           </item>
          </layout>
         </widget>
        </widget>
       </item>
       <item>
        <widget class="QLabel" name="checksLabel">
         <property name="text">
          <string>Checks</string>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QListWidget" name="checksList">
         <property name="wordWrap">
          <bool>true</bool>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QLabel" name="hintLabel">
         <property name="text">
          <string>Drag the zone to move it. Its handles size it (squares), lift it (arrow) and turn it (circle); Shift snaps. Left-drag turns the view, right-drag moves it, the wheel zooms.</string>
         </property>
         <property name="wordWrap">
          <bool>true</bool>
         </property>
        </widget>
       </item>
      </layout>
     </widget>
    </widget>
   </item>
   <item>
    <widget class="QLabel" name="statusLabel">
     <property name="text">
      <string/>
     </property>
     <property name="wordWrap">
      <bool>true</bool>
     </property>
    </widget>
   </item>
  </layout>
 </widget>
